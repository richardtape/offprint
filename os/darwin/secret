#!/bin/bash
# A named secret of one site's (an API token its host adapter needs, say), in the macOS login Keychain, never in a file:
# a generic password, service "offprint", account SITE_NAME/NAME, SITE_NAME being site.json's "name" (so two sites keep
# separate values under the same NAME).
#   TOOL/os/darwin/secret get NAME      print the value on stdout, and nothing else (no line end after it)
#   TOOL/os/darwin/secret set NAME      store the value read from stdin, in place of any stored before
#   TOOL/os/darwin/secret delete NAME   remove it
# It holds the value, so the bash that runs it is /bin/bash (macOS's own, the 3.2 it is written for), named on the #!
# line and by lib/adapter.sh, never a bash looked up on the PATH, which could be one WordPress put in wp-content/.
# Run it from inside the site folder, or with OFFPRINT_SITE set to it (lib/adapter.sh's offprint_secret_get, _set and
# _delete run it so, for the site loaded); site.json is read and checked as every Offprint command reads it, and its
# name checked again before it becomes part of the account. NAME: a lowercase letter, then up to 60 lowercase letters,
# digits and dashes.
#
# The value is one line of printable ASCII (space to ~), 1 to 1024 characters. set takes it from stdin, with or without
# one line end after it (which is not part of it), and refuses, before security is run, anything else: a NUL, a second
# line, any other control character, a character outside ASCII (security hands those back as broken hex, so they could
# not come back exactly), an empty value, a longer one. No message ever shows the value.
# The value never reaches a process's arguments, its environment, a file, or set -x output (xtrace is off throughout, and
# so is allexport, which an inherited SHELLOPTS could turn on, exporting the variables that hold the value or its hex),
# nor any program's stdin but security's (what runs before set reads it has stdin from /dev/null), nor any program
# started while it is held but security (get's answer and set's line are worked on with the shell's own builtins):
#   - set hands it to security on stdin, through a pipe: "security -i" reads the one command line
#       add-generic-password -U -s offprint -a SITE_NAME/NAME -X HEX
#     HEX being the value's bytes in hex, made with the shell's own printf (a builtin, so no process sees them). So
#     security's arguments are just "-i"; and since HEX is digits and a-f only, nothing in the value can be taken by
#     security as a quote or a word of its own. What security says is dropped (it doesn't echo the line, but nothing of
#     the value can then reach a message): only its status is used. Two things security -i does, both seen: it reads a
#     line into 4096 bytes, and cuts a longer one in two, running the rest as a command of its own (and the cut command,
#     with no keychain named, adds to the default keychain); so a line of 4000 characters or more is never sent (the
#     longest the limits above allow is under 2200). And a last line without its line end is not run at all.
#   - get reads security's answer (the value and a line end) into a variable, and prints the value; nothing on disk.
# Exit status:
#   0  done (get: the value is on stdout)
#   1  no secret of that name is stored for this site (get, delete; for get, an empty one counts as none)
#   2  a usage problem: no such command, a bad NAME, a value refused (set); or the site folder or its site.json isn't right
#   3  the Keychain couldn't be used without a prompt: security exited 36 (user interaction is not allowed), 51 (the
#      keychain's password was refused), 128 (the prompt was cancelled) or 152 (unable to obtain authorization: what a
#      locked keychain gave when tried, from a process with no terminal); or, for get, security hadn't answered after 10
#      seconds
#   4  security failed some other way (its status is named), or isn't there; or (get) its answer didn't come back whole
#      (the shell running security was stopped first), isn't one line of printable ASCII, or is longer than the 1024
#      characters set ever stores
# get never waits on a prompt: security runs with stdin from /dev/null, and once it has run 10 seconds it is killed, with
# every process it started (see limited, below). A publish run by the launchd agent has no one to answer a prompt. set
# and delete are run by the owner, at a terminal, so a prompt there (macOS asking for the login Keychain's password) is
# theirs to answer: they have no limit.
# The Keychain is the user's default one for set (the login Keychain, unless changed), and the keychain search list for
# get and delete.
#
# Test seams, for tests/secret.test.sh only:
#   OFFPRINT_SECURITY        the path of the security command to run, instead of /usr/bin/security (refused, exit 4,
#                            when it is in the site folder or leads there)
#   OFFPRINT_SECRET_TIMEOUT  get's limit in whole seconds, 1 to 10; any other value is ignored. So it can only shorten
#                            the limit, never lengthen or remove it.
# Needs bash 3.2 (macOS) or newer.
set +x
set +a   # (after set +x, so the one line a trace shows is still "+ set +x")
set -u
# The names below that hold the value, its hex or the line holding that, never taken from the environment: one exported
# by the caller would stay exported once this gives it the value, and reach security's environment.
unset value hex h line answer
export LC_ALL=C
IFS=$' \t\n'
# Everything up to the value: run with stdin from /dev/null, so no program it starts (mktemp, php, rm, cat, readlink:
# found on the PATH, once lib/site.sh has made it safe) is handed what set reads from it, the value. (bash keeps the
# real stdin aside for set's read, close-on-exec, so none of them can reach it that way either.)
{
  # This folder, by the shell's own builtins; then lib/site.sh, which makes the PATH safe to use before anything is
  # looked up on it.
  case "${BASH_SOURCE[0]}" in */*) DARWIN="${BASH_SOURCE[0]%/*}" ;; *) DARWIN=. ;; esac
  DARWIN="$(CDPATH= cd -P -- "${DARWIN:-/}" && pwd -P)" || exit 2
  # shellcheck source=lib/site.sh
  . "$DARWIN/../../lib/site.sh" || exit 2
  SECURITY="${OFFPRINT_SECURITY:-/usr/bin/security}"
  LIMIT=10
  case "${OFFPRINT_SECRET_TIMEOUT:-}" in [1-9]|10) LIMIT="$OFFPRINT_SECRET_TIMEOUT" ;; esac
  MAX=1024
  NAME_RE='^[a-z][a-z0-9-]{0,60}$'
  STATUS_RE='^[0-9]{1,3}$'
  STOPPED_RE='^[01]$'
  SITE_NAME_RE='^[a-z][a-z0-9-]{0,30}$'   # lib/config.php's own rule for "name"

  usage() { echo "usage: os/darwin/secret get|set|delete NAME" >&2; exit 2; }
  [ $# -eq 2 ] || usage
  CMD="$1"; NAME="$2"
  case "$CMD" in get|set|delete) ;; *) usage ;; esac
  if ! [[ $NAME =~ $NAME_RE ]]; then
    echo "A secret's name is a lowercase letter, then up to 60 lowercase letters, digits and dashes; $(_offprint_shown "$NAME") isn't one." >&2
    exit 2
  fi
  offprint_find_site
  offprint_load_site
  if ! [[ $SITE_NAME =~ $SITE_NAME_RE ]]; then
    echo "site.json's name, $(_offprint_shown "$SITE_NAME"), isn't a site's name, so no secret can be kept for it." >&2
    exit 2
  fi
  ACCOUNT="$SITE_NAME/$NAME"
  # The security run (set hands it the value) is never one in the site folder, which WordPress can write, nor one
  # leading there by a link (each followed by hand: older macOS has no readlink -f). Only OFFPRINT_SECURITY, the tests'
  # seam, could name one.
  sec="$SECURITY"; i=0
  while [ -L "$sec" ] && [ "$i" -lt 40 ]; do
    link="$(readlink -- "$sec")" || break
    case "$link" in /*) sec="$link" ;; *) case "$sec" in */*) sec="${sec%/*}/$link" ;; *) sec="./$link" ;; esac ;; esac
    i=$((i + 1))
  done
  if offprint_inside_site "$SECURITY" || offprint_inside_site "$sec"; then
    case "$CMD" in set) after="; nothing was stored." ;; *) after="." ;; esac
    echo "OFFPRINT_SECURITY, $(_offprint_shown "$SECURITY"), is inside the site folder, which WordPress can write (or leads there), so it wasn't run$after" >&2
    exit 4
  fi
  if [ ! -f "$SECURITY" ] || [ ! -x "$SECURITY" ]; then
    echo "There is no security command at $SECURITY: secrets are kept in the macOS login Keychain, so this needs macOS." >&2
    exit 4
  fi
} < /dev/null

# freeze PID: stops (STOP) that process, then each process under it, top down, printing each pid on a line. A stopped
# process can start no other, so the list is whole: no child started meanwhile gets away.
freeze() { local p; kill -STOP "$1" 2> /dev/null; echo "$1"; for p in $(pgrep -P "$1" 2> /dev/null); do freeze "$p"; done; }
# kill_all: CMD (see limited) and every process under it, frozen, then killed (KILL: none of them runs again, not even a
# handler for TERM, so none can start another or ignore it). Any one of them left would keep get waiting, holding open
# the output it reads to the end.
kill_all() {
  # shellcheck disable=SC2046 # one pid a word
  [ -z "$pid" ] || kill -KILL $(freeze "$pid") 2> /dev/null
}
# limited CMD...: runs CMD with stdin from /dev/null and its stderr dropped, its stdout this function's; once it has run
# LIMIT seconds, kill_all. Then prints ":STOPPED:STATUS" after CMD's output (STOPPED 1 when it was killed), so its
# caller can tell the two apart whatever CMD printed. An INT or TERM to this shell (bin/publish's cleanup sends a TERM to
# each process under it) kills CMD too.
limited() {
  local pid waited=0 stopped=0 rc
  "$@" < /dev/null 2> /dev/null &
  pid=$!
  trap 'kill_all; exit 130' INT
  trap 'kill_all; exit 143' TERM
  while kill -0 "$pid" 2> /dev/null && [ "$waited" -lt $((LIMIT * 10)) ]; do sleep 0.1; waited=$((waited + 1)); done
  if kill -0 "$pid" 2> /dev/null; then stopped=1; kill_all; fi
  wait "$pid" 2> /dev/null; rc=$?; pid=""
  printf ':%s:%s' "$stopped" "$rc"
}

case "$CMD" in
  get)
    answer="$(limited "$SECURITY" find-generic-password -s offprint -a "$ACCOUNT" -w)"; whole=$?
    rc="${answer##*:}"; answer="${answer%:*}"; stopped="${answer##*:}"; value="${answer%:*}"; answer=""
    # The status comes last, printed by the shell that ran security, as the last thing it does: so it is there only when
    # that shell ended well. Stopped first (an INT or a TERM, after security answered), it never printed it, and all that
    # came is security's answer, the value: nothing of that may be taken for a status, nor shown. So the two are used
    # only when that shell ended with 0, STOPPED is 0 or 1 and STATUS one to three digits; and no message here shows
    # anything read from security but those digits.
    if [ "$whole" != 0 ] || ! [[ $stopped =~ $STOPPED_RE ]] || ! [[ $rc =~ $STATUS_RE ]]; then
      value=""; rc=""; stopped=""
      echo "The Keychain's answer for $NAME didn't come back whole, so none of it was used." >&2
      exit 4
    fi
    if [ "$stopped" = 1 ]; then echo "The login Keychain is locked, so $NAME couldn't be read." >&2; exit 3; fi
    case "$rc" in
      0) ;;
      44) echo "No secret called $NAME is stored for this site; run offprint adapter setup." >&2; exit 1 ;;
      36|51|128|152) echo "The login Keychain is locked, so $NAME couldn't be read." >&2; exit 3 ;;
      *) echo "security couldn't read $NAME from the login Keychain (it failed with status $rc)." >&2; exit 4 ;;
    esac
    value="${value%$'\n'}"   # security's line end after it
    if [ -z "$value" ]; then echo "No secret called $NAME is stored for this site; run offprint adapter setup." >&2; exit 1; fi
    case "$value" in
      *[!\ -~]*) value=""; echo "The Keychain's answer for $NAME isn't one line of printable characters, so it wasn't used." >&2; exit 4 ;;
    esac
    # Longer than set ever stores (one stored some other way, in Keychain Access, say): not used either.
    if [ "${#value}" -gt "$MAX" ]; then value=""; echo "The Keychain's answer for $NAME is longer than $MAX characters, so it wasn't used." >&2; exit 4; fi
    printf '%s' "$value"
    exit 0 ;;

  set)
    # At most MAX + 2 bytes are read (the value, a line end, and one more to tell a longer one), up to a NUL: read
    # stops there, and succeeds, before the end of the input and the limit.
    value=""; nul=0
    if IFS= read -r -d '' -n $((MAX + 2)) value && [ "${#value}" -lt $((MAX + 2)) ]; then nul=1; fi
    why=""
    if [ "$nul" = 1 ]; then why="has a NUL in it"
    else
      value="${value%$'\n'}"
      case "$value" in
        *$'\n'*) why="has more than one line" ;;
        *[[:cntrl:]]*) why="has a control character in it (a tab, a carriage return, an escape, say)" ;;
        *[!\ -~]*) why="has a character outside ASCII, which the Keychain would hand back as hex" ;;
        "") why="is empty" ;;
      esac
      [ -n "$why" ] || [ "${#value}" -le "$MAX" ] || why="is longer than $MAX characters"
    fi
    if [ -n "$why" ]; then value=""; echo "The value given for $NAME $why; nothing was stored." >&2; exit 2; fi
    hex=""; i=0
    while [ "$i" -lt "${#value}" ]; do printf -v h '%02x' "'${value:i:1}"; hex="$hex$h"; i=$((i + 1)); done
    value=""
    line="add-generic-password -U -s offprint -a $ACCOUNT -X $hex"; hex=""
    # Never reached with the limits above (see the header): security -i would cut the line, and run its rest.
    if [ "${#line}" -ge 4000 ]; then line=""; echo "The value given for $NAME is too long; nothing was stored." >&2; exit 2; fi
    printf '%s\n' "$line" 2> /dev/null | "$SECURITY" -i > /dev/null 2>&1
    rc="${PIPESTATUS[1]}"; line=""
    case "$rc" in
      0) exit 0 ;;
      36|51|128|152) echo "The login Keychain is locked, so $NAME couldn't be stored." >&2; exit 3 ;;
      *) echo "security couldn't store $NAME in the login Keychain (it failed with status $rc); nothing was stored." >&2; exit 4 ;;
    esac ;;

  delete)
    "$SECURITY" delete-generic-password -s offprint -a "$ACCOUNT" < /dev/null > /dev/null 2>&1; rc=$?
    case "$rc" in
      0) exit 0 ;;
      44) echo "No secret called $NAME is stored for this site, so nothing was deleted." >&2; exit 1 ;;
      36|51|128|152) echo "The login Keychain is locked, so $NAME couldn't be deleted." >&2; exit 3 ;;
      *) echo "security couldn't delete $NAME from the login Keychain (it failed with status $rc)." >&2; exit 4 ;;
    esac ;;
esac
