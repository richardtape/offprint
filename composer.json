{
    "name": "richardtape/offprint",
    "description": "Offprint runs WordPress on your Mac and publishes a static copy of it to the web",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Offprint\\": "plugin/offprint/src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
